# Copy this file to `.env`:  cp .env.example .env
# `.env` is gitignored and never committed.

# Local SQLite. Path resolved from the project root -> data/ at the repo root.
DATABASE_URL="file:./data/quoin.sqlite"

# Market-data provider
# MARKET_DATA_API_KEY=""

# OpenFIGI — optional, free, and worth the two minutes it takes to sign up at
# https://www.openfigi.com/user/signup
#
# `pnpm identity:resolve` gives every holding a canonical id so that a company held
# directly and held again inside a fund counts once instead of twice. Without a key the
# endpoint allows 10 lookups per request and 25 requests a minute, so a broad index fund
# takes about twenty minutes; with one it is 100 per request and finishes in seconds.
# It works either way — lookups run heaviest-first, so the rows you can actually see
# resolve in the first few requests regardless.
# OPENFIGI_API_KEY=""
