# Copy this file to `.env`:  cp .env.example .env
# `.env` is gitignored and never committed.

# Local SQLite. Path resolved from the project root -> data/ at the repo root.
#
# `data/quoin.sqlite` is the live ledger: real trades, and the one thing here that
# cannot be regenerated. `data/dev.sqlite` is scratch — throw it away and re-run
# `pnpm db:seed` for a fresh synthetic portfolio.
#
# Agent sessions override this with the scratch database (.claude/settings.json), and
# dotenv does not overwrite a variable the environment already set, so the override
# wins over this file. Destructive commands refuse the live ledger regardless.
DATABASE_URL="file:./data/quoin.sqlite"

# OpenFIGI — optional, free, and worth the two minutes it takes to sign up at
# https://www.openfigi.com/user/signup
#
# `pnpm identity:resolve` gives every holding a canonical id so that a company held
# directly and held again inside a fund counts once instead of twice. Without a key the
# endpoint allows 10 lookups per request and 25 requests a minute, so a broad index fund
# takes about twenty minutes; with one it is 100 per request and finishes in seconds.
# It works either way — lookups run heaviest-first, so the rows you can actually see
# resolve in the first few requests regardless.
# OPENFIGI_API_KEY=""

# Opportunity-cost benchmark (/coste-oportunidad and the Resumen card)
#
# The symbol every real contribution is replayed into, in euros and in MWR. Must be
# an instrument you have mapped with `pnpm prices:map <ISIN> <SYMBOL>` and backfilled
# with EUR price history. Defaults to a global all-world ETF when unset.
# BENCHMARK_SYMBOL="VWCE.DE"
