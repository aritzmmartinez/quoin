{
  "name": "quoin",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:seed": "tsx scripts/db-guard.ts \"seed the demo database\" && prisma migrate deploy && tsx scripts/seed-demo.ts",
    "ingest": "tsx scripts/ingest.ts",
    "prices:sync": "tsx scripts/prices-sync.ts",
    "prices:map": "tsx scripts/prices-map.ts",
    "prices:backfill": "tsx scripts/prices-backfill.ts",
    "ipc:sync": "tsx scripts/ipc-sync.ts",
    "exposure:map": "tsx scripts/exposure-map.ts",
    "target:set": "tsx scripts/target-set.ts",
    "twr:explain": "tsx scripts/twr-explain.ts",
    "tax:explain": "tsx scripts/tax-explain.ts",
    "projection:converge": "tsx scripts/projection-converge.ts",
    "identity:resolve": "tsx scripts/identity-resolve.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "verify:full": "pnpm run verify && pnpm run test:integration"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.3",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "Personal, open-source, local-first investment platform with portquoin analytics, look-through exposure and Bizkaia foral tax support.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0"
}
