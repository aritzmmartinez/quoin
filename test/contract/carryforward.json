{
  "contract": "carryforward",
  "version": 1,
  "description": "The generic carryforward of one savings pool (carryforwardPool) and of two pools advancing together (carryforwardPools), as pure functions over each year's own net. pools holds one or two maps from year to that year's own net; a year missing is 0. The window is targetYear − years through targetYear: a loss older than that has expired and is never seen. Each year, in order: a positive own net consumes pending losses oldest year first, and a negative one becomes that year's pending loss. finalNet is the last year's balance after both; savingsBase adds the two pools' finalNet where positive. Every case has a cross limit of 0, Bizkaia's, so crossOffset is always 0: how two pools cross at a positive limit is not pinned here and will be with régimen común, whose carried losses cross too. Amounts are decimal strings. Shared with the mobile client: both implementations must reproduce every case. expect is written by running the TypeScript core; byHand.figures, where a case has it, are worked out by hand, its arithmetic says how, and each key is a dotted path into expect.",
  "cases": [
    {
      "name": "One pool: a negative net carried and absorbed by the years after it",
      "targetYear": 2026,
      "years": 4,
      "pools": [
        {
          "2023": "-300",
          "2024": "100",
          "2025": "50",
          "2026": "400"
        }
      ],
      "byHand": {
        "arithmetic": "Window 2022–2026. 2023 leaves 300 pending; 2024 takes 100 (200 left), 2025 takes 50 (150 left), 2026 takes the 150 left: 400 − 150 = 250.",
        "figures": {
          "steps.2.pendingLossRemaining": "200",
          "steps.3.finalNet": "0",
          "steps.4.consumedFromCarryforward": "150",
          "finalNet": "250"
        }
      },
      "expect": {
        "steps": [
          {
            "year": 2022,
            "ownNet": "0",
            "crossOffset": "0",
            "consumedFromCarryforward": "0",
            "finalNet": "0",
            "pendingLossRemaining": "0"
          },
          {
            "year": 2023,
            "ownNet": "-300",
            "crossOffset": "0",
            "consumedFromCarryforward": "0",
            "finalNet": "-300",
            "pendingLossRemaining": "300"
          },
          {
            "year": 2024,
            "ownNet": "100",
            "crossOffset": "0",
            "consumedFromCarryforward": "100",
            "finalNet": "0",
            "pendingLossRemaining": "200"
          },
          {
            "year": 2025,
            "ownNet": "50",
            "crossOffset": "0",
            "consumedFromCarryforward": "50",
            "finalNet": "0",
            "pendingLossRemaining": "150"
          },
          {
            "year": 2026,
            "ownNet": "400",
            "crossOffset": "0",
            "consumedFromCarryforward": "150",
            "finalNet": "250",
            "pendingLossRemaining": "0"
          }
        ],
        "finalNet": "250"
      }
    },
    {
