// Prisma 7: ESM `prisma-client` generator with its own output; the URL lives in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../app/adapters/persistence/generated"
}

datasource db {
  provider = "sqlite"
}

/// Instrument master. Key = identifier (ISIN normally; symbol for crypto).
model Instrument {
  id         String   @id
  name       String
  type       String // ETF | STOCK | CRYPTO | BOND | COMMODITY | ...
  currency   String // ISO 4217 (instrument's denomination currency)
  assetClass String? // from TR: FUND | STOCK | CRYPTO | SYNTHETIC ...
  quoteSymbol String? // provider symbol for price quotes (e.g. "VWCE.DE"); set manually, never from ingestion
  exposureKind   String? // COMPANY | EQUITY_FUND | BOND_FUND | COMMODITY | CRYPTO; set manually, never from ingestion
  exposureLeafId String? // leaf identity for COMMODITY/CRYPTO (e.g. "XAU", "BTC"); defaults to the instrument id
  createdAt  DateTime @default(now())

  entries  LedgerEntry[]
  prices   PriceSnapshot[]
  holdings EtfHolding[]
}

/// Immutable ledger: the source of truth. Positions, P&L, allocation... are DERIVED from here.
model LedgerEntry {
  id     String   @id // uuid
  ts     DateTime // execution timestamp
  /// BUY | SELL | DIVIDEND | DEPOSIT | WITHDRAWAL | INTEREST — and nothing else.
  ///
  /// This list is exactly what `ledgerEventSchema` models, enforced by a CHECK
  /// constraint because the two must not drift: `rowToEvent` throws on a type it
  /// cannot read, so a row the database accepts but the domain refuses takes the
  /// whole app down on the next read, not at the insert that caused it.
  ///
  /// FEE, TAX_WITHHOLDING and SPLIT used to be listed here and were never
  /// modelled. No broker emits them either: Trade Republic reports fees as a
  /// column on the trade and Kraken as `fee` on the ledger row, which is why
  /// `fees` and `taxWithheld` are columns rather than event types.
  type   String
  sleeve String? // CORE | TRADING | null (cash-level movements have no sleeve)

  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id])

  // Money is ALWAYS a String (decimal) -> operated on with decimal.js.
  // Never `number`, never the ORM's Decimal type on SQLite (confirmed read bug).
  quantity    String? // quantity; fractions up to 10 decimals
  price       String? // per-unit price, in the instrument's currency
  grossAmount String // gross value of the operation, in `currency`
  fees        String  @default("0")
  taxWithheld String  @default("0")

  currency String // operation currency (ISO 4217)
  fxToBase String  @default("1") // rate to EUR at operation time

  account    String  @default("trade-republic")
  source     String  @default("MANUAL") // MANUAL | TR_CSV | ...
  externalId String? // source transaction id (TR transaction_id) -> dedup key
  note       String?
  createdAt  DateTime @default(now())

  @@unique([source, externalId]) // idempotent ingestion (NULLs are distinct in SQLite -> manual entries don't collide)
  @@index([ts])
  @@index([instrumentId])
}

/// Point-in-time price for an instrument, from a market-data provider.
/// Append-only history: the latest price per instrument is max(asOf). This also
/// feeds the "updated X ago" freshness indicator and future TWR/MWR.
model PriceSnapshot {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  // Money is ALWAYS a String (decimal) -> operated on with decimal.js.
  price    String // per-unit price, in `currency`
  currency String // ISO 4217 as returned by the provider

  asOf   DateTime // provider's quote timestamp (market time)
  source String   @default("YAHOO") // provider id

  createdAt DateTime @default(now()) // when we fetched/persisted it

  @@unique([instrumentId, asOf]) // idempotent sync: same quote time won't duplicate
  @@index([instrumentId])
  @@index([asOf])
}

// A fund's published composition.
//
// Unlike PriceSnapshot, this is REPLACE-only, not append-only: a holdings file is
// a snapshot of what the fund holds today, not an event that happened. Importing
// replaces the fund's rows wholesale, because a constituent that left the index
// must disappear — appending would keep it forever.
//
// The residual (1 - sum of weights) is DERIVED at read time, never stored: it is
// the fund's cash, derivatives and rounding, and storing it next to the weights
// invites the day the two disagree.
model EtfHolding {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  identity     String // ISIN when the issuer publishes one, otherwise its ticker
  identityKind String // ISIN | TICKER
  name         String

  weight String // fraction of the fund as a decimal string ("0.044503")

  asOf      DateTime // the issuer's as-of date, confirmed by a human on import
  createdAt DateTime @default(now())

  @@unique([instrumentId, identity])
  @@index([instrumentId])
}

// The savings plan: what the monthly contribution is SUPPOSED to look like.
//
// Versioned by `activeFrom` and never edited in place, for the same reason the
// ledger is immutable: "what was I aiming at in March" has to stay answerable
// after the plan changes. A new plan is a new row, and the one in force on a
// date is the latest `activeFrom` <= that date — resolved by `activeFrom`, the
// business date, never by `createdAt`, exactly as prices resolve by `asOf`.
model PortfolioTarget {
  id         String   @id // uuid
  name       String
  activeFrom DateTime // the date this version takes over
  note       String?
  createdAt  DateTime @default(now()) // tie-break only: two versions from the same day

  lines PortfolioTargetLine[]

  @@index([activeFrom])
}

/// One instrument's slice of the monthly contribution.
///
/// The AMOUNT is what is planned; the weight is DERIVED from it at read time and
/// never stored. The savings plan is written in euros per month ("300 into FTSE"),
/// so the euros are the fact and the percentage is the projection of it — storing
/// both invites the day they disagree, which is how the fee bug happened.
model PortfolioTargetLine {
  id       String          @id @default(uuid())
  targetId String
  target   PortfolioTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  /// Deliberately NOT a relation to Instrument: a plan may name something never
  /// bought yet, which has no Instrument row until the first trade is imported.
  instrumentId String

  // Money is ALWAYS a String (decimal) -> operated on with decimal.js.
  monthlyAmount String

  @@unique([targetId, instrumentId]) // one line per instrument; two would split its weight
  @@index([targetId])
}

// Cache of raw identity -> canonical id, so a lookup is paid for once ever.
//
// Resolution happens at IMPORT time and nothing else touches the network: the
// allocation screen reads this table like any other row. Misses are cached too
// — an identity the provider cannot place would otherwise be re-asked on every
// import forever, and unauthenticated lookups are rationed by the minute.
model SecurityIdentity {
  identity     String @id // "US67066G1040" or "NVDA.US", exactly as published
  identityKind String // ISIN | TICKER

  /** Null when the provider found nothing, or found more than one candidate. */
  canonicalId String?
  /** resolved | not-found | ambiguous — kept so a miss can be explained. */
  status String
  source String

  resolvedAt DateTime @default(now())

  @@index([canonicalId])
}
